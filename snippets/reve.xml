<?xml version="1.0" encoding="UTF-8"?>
<manifest>

<!-- Remove -->
<remove-project path="build/make" />
<remove-project path="bootable/recovery" />
<remove-project path="external/wpa_supplicant_8" />
<remove-project path="frameworks/base" />
<remove-project path="frameworks/native" />
<remove-project path="packages/apps/Backgrounds" />
<remove-project path="packages/apps/Launcher3" />
<remove-project path="packages/apps/LineageParts" />
<remove-project path="packages/apps/Settings" />
<remove-project path="packages/apps/Updater" />
<remove-project path="packages/apps/ThemePicker" />
<remove-project path="vendor/lineage" />

<!-- Apps -->
<project path="packages/apps/Backgrounds" name="android_packages_apps_Backgrounds" remote="reve" />
<project path="packages/apps/Launcher3" name="android_packages_apps_Launcher3" remote="reve" groups="pdk-fs,sysui-studio,pdk-cw-tvc" />
<project path="packages/apps/LineageParts" name="android_packages_apps_LineageParts" remote="reve" />
<project path="packages/apps/Settings" name="android_packages_apps_Settings" remote="reve" groups="pdk-fs,pdk-cw-tvc,sysui-studio" />
<project path="packages/apps/Updater" name="android_packages_apps_Updater" remote="reve" />
<project path="packages/apps/ThemePicker" name="android_packages_apps_ThemePicker" remote="reve" />

<!-- Build -->
  <project path="build/make" name="android_build_make" groups="pdk,sysui-studio" remote="reve" >
    <linkfile src="CleanSpec.mk" dest="build/CleanSpec.mk" />
    <linkfile src="buildspec.mk.default" dest="build/buildspec.mk.default" />
    <linkfile src="core" dest="build/core" />
    <linkfile src="envsetup.sh" dest="build/envsetup.sh" />
    <linkfile src="target" dest="build/target" />
    <linkfile src="tools" dest="build/tools" />
  </project>

<!-- External -->
<project path="external/wpa_supplicant_8" name="android_external_wpa_supplicant_8" groups="pdk" remote="reve" />

<!-- Frameworks -->
<project name="android_frameworks_base" path="frameworks/base" remote="reve" groups="pdk-cw-fs,pdk-fs,sysui-studio" />
<project name="android_frameworks_native" path="frameworks/native" remote="reve" groups="pdk,sysui-studio"  />

<!-- System -->
<project path="bootable/recovery" name="android_bootable_recovery" remote="reve" groups="pdk" />

<!-- Vendor -->
<project name="android_vendor_lineage" path="vendor/lineage" remote="reve" />

</manifest>
